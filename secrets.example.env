# Copy this file to secrets.env. Docker Compose passes these values to the container,
# and config.yml/config.example.yml expands ${VARIABLE} placeholders at startup.

OLLAMA_URL=http://192.0.2.10:11434

# Optional Frigate IP/CIDR classification. Unmatched requests use the Odysseus
# policy, so Odysseus needs no stable Docker IP. Leave blank until Frigate is added.
FRIGATE_SOURCE=

# Optional bearer token for /_intermediary/v1/* and the live dashboard data.
# Generate one with: openssl rand -hex 32
OBSERVABILITY_TOKEN=

# Required to use the protected /settings page and settings API.
# This credential can change scheduling and backend configuration, so keep it
# host-managed and distinct from the other tokens:
#   openssl rand -hex 32
SETTINGS_TOKEN=

# Required bearer token for the pause/resume maintenance API. This is a
# write-capable administrative credential, so generate and store it separately:
#   openssl rand -hex 32
MAINTENANCE_TOKEN=
