# Set the EXACT Ollama upstream origin configured in the intermediary, not its
# public 11435 proxy URL and not Frigate. Do not assume this example is yours.
MANAGED_OLLAMA_ORIGIN=http://192.0.2.10:11434
# Locate using `command -v amd-smi`, then use the absolute root-owned path.
AMD_SMI_PATH=/opt/rocm/bin/amd-smi
HOST_HELPER_SOCKET=/run/ollama-intermediary-host/control.sock
HOST_HELPER_STATE=/var/lib/ollama-intermediary-host/state.json
